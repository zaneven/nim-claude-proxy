# 服务端口配置
PORT=8000
HOST=0.0.0.0

# NVIDIA NIM API Keys (多个 Key 用逗号分隔)
NVIDIA_NIM_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3

# 默认使用的 NIM 模型名称 (也可通过客户端 request.model 传参覆盖)
NIM_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b

# NIM 代理/Base URL (默认为官方 NVIDIA API)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Key 触发 429/5xx 后的冷却时间 (单位: 秒)
KEY_COOLDOWN_SECONDS=60.0
